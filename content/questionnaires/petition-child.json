        {
          "id": "affirm",
          "type": "choice",
          "label": "What you wrote is based on",
          "required": true,
          "options": [
            {
              "value": "a",
              "label": "What I know myself"
            },
            {
              "value": "b",
              "label": "What others told me and I believe is true"
            }
          ],
