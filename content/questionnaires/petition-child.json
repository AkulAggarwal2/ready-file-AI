    {
      "id": "restrained",
      "form": "PO-0104",
      "title": "Confidential Form: about the other person",
      "intro": "Police use this to find the person and serve the order. Only the court, the clerk, the prosecutor, and police see it. Fill in what you know.",
      "fields": [
        {
          "id": "restrained.dob",
          "type": "date",
          "label": "Date of birth",
