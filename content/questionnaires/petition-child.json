        },
        {
          "id": "restrained.homeAddress",
          "type": "textarea",
          "label": "Home address",
          "rows": 2
        },
        {
          "id": "restrained.postalAddress",
          "type": "textarea",
          "label": "Mailing address, if different",
          "rows": 2
        },
        {
          "id": "restrained.phone.home",
          "type": "phone",
          "label": "Home phone"
        },
        {
          "id": "restrained.phone.work",
          "type": "phone",
          "label": "Work phone"
