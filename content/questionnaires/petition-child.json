{
  "_about": "The questions for the petition filed on behalf of a child (PO-0101, PO-0104, PNW-0102), in each form's order. Field ids match the keys in content/pdfMaps. showIf fields starting with $ come from the earlier steps.",
  "id": "petition-child",
  "filer": "petitioner",
  "packet": [
    {
      "form": "PO-0101",
      "copies": 4
    },
    {
      "form": "PNW-0102",
      "copies": 3
    },
    {
      "form": "PO-0104",
      "copies": 1,
      "confidential": true
    }
  ],
  "instructions": {
    "title": "Your petition: before you file (do not file this page)",
    "lines": [
      "This file has the petition and the Notice of Exclusion, with your answers printed on them. The Confidential Form is in a separate file. Do not print it with this one.",
      "Read every page, and fix anything that is wrong by hand or in ReadyFile.",
      "Sign and date the petition by hand. You sign it under penalty of perjury. Some courts ask you to sign in front of the clerk, so you can wait until you file.",
      "Print 4 copies of the petition and 3 copies of the Notice of Exclusion (PNW-0102). One copy of the petition is given to the other person.",
      "Take everything to the clerk's office in the county where you are filing. There is no fee to file a petition for an order for protection.",
      "The clerk fills in the case number, the court's room, and the cover sheet. Leave those blank.",
      "If you based the petition on what others told you, attach sworn statements (affidavits) from the people who saw or heard it.",
      "This page is not part of your filing. Remove it before you file."
    ]
  },
  "sections": [
    {
      "id": "caption",
      "form": "PO-0101",
      "title": "The court and the people in the case",
      "intro": "On a petition for a child, the child is the Petitioner, and you file as the child's \"next friend.\" This goes at the top of the petition and the other forms.",
      "fields": [
        {
          "id": "court.county",
          "type": "text",
          "label": "County where you are filing",
          "required": true
        },
        {
          "id": "court.name",
          "type": "text",
          "label": "Name of the court",
          "hint": "Like Superior or Circuit. The clerk's office can tell you. You can leave it blank."
        },
        {
          "id": "child.first",
          "type": "text",
          "label": "The child's first name",
          "required": true
        },
        {
          "id": "child.middle",
          "type": "text",
          "label": "The child's middle name"
        },
        {
          "id": "child.last",
          "type": "text",
          "label": "The child's last name",
          "required": true
        },
        {
          "id": "petitioner.first",
          "type": "text",
          "label": "Your first name",
          "required": true,
          "hint": "You sign as the child's next friend."
        },
        {
          "id": "petitioner.middle",
          "type": "text",
          "label": "Your middle name"
        },
        {
          "id": "petitioner.last",
          "type": "text",
          "label": "Your last name",
          "required": true
        },
        {
          "id": "q1.other.detail",
          "type": "text",
          "label": "How do you represent the child?",
          "hint": "Question 1 asks you to describe it, since you are not the child's parent or guardian.",
          "required": true,
          "showIf": {
            "field": "$childRole",
            "equals": "other"
          }
        },
        {
          "id": "respondent.first",
          "type": "text",
          "label": "The other person's first name",
          "required": true,
          "hint": "The court needs the person's correct, full name."
        },
        {
          "id": "respondent.middle",
          "type": "text",
          "label": "The other person's middle name"
        },
        {
          "id": "respondent.last",
          "type": "text",
          "label": "The other person's last name",
          "required": true
        }
      ]
    },
    {
      "id": "q2-3",
      "form": "PO-0101",
      "title": "Questions 2 and 3: about the other person",
      "fields": [
        {
          "id": "q2.blood-adoption.detail",
          "type": "text",
          "label": "How is the person related to the child?",
          "hint": "Like uncle or grandmother. The form says \"The Respondent is the child's ___.\"",
          "showIf": {
            "field": "$relationship",
            "equals": "blood-adoption"
          }
        },
        {
          "id": "q2.marriage.detail",
          "type": "text",
          "label": "How is the person related to the child by marriage?",
          "hint": "Like stepfather.",
          "showIf": {
            "field": "$relationship",
            "equals": "marriage"
          }
        },
        {
          "id": "q2.nonFamily",
          "type": "choice",
          "label": "Which one best describes what the person did to the child?",
          "hint": "Question 2 asks this when the person is not a family or household member. Pick only one.",
          "options": [
            {
              "value": "stalking",
              "label": "Stalked the child"
            },
            {
              "value": "sex-offense",
              "label": "Committed a sex offense against the child"
            },
            {
              "value": "sex-grooming",
              "label": "Contacted the child again and again to prepare them for sexual activity (sex grooming)"
            },
            {
              "value": "harassment",
              "label": "Harassed the child again and again"
            }
          ],
          "showIf": {
            "field": "$relationship",
            "equals": "none"
          }
        },
        {
          "id": "q2.offender.cause",
          "type": "text",
          "label": "Case number (cause number) of the conviction",
          "showIf": {
            "field": "$convicted",
            "equals": "yes"
          }
        },
        {
          "id": "q2.offender.court",
          "type": "text",
          "label": "Court that convicted the person",
          "showIf": {
            "field": "$convicted",
            "equals": "yes"
          }
        },
        {
          "id": "q2.offender.state",
          "type": "text",
          "label": "State of that court",
          "showIf": {
            "field": "$convicted",
            "equals": "yes"
          }
        },
        {
          "id": "q2.offender.date",
          "type": "date",
          "label": "Date of conviction",
          "showIf": {
            "field": "$convicted",
            "equals": "yes"
          }
        },
        {
          "id": "q2.offender.lifetime",
          "type": "yesno",
          "label": "Does the person have to register as a sex or violent offender for life, for an offense against the child?",
          "hint": "If so, the order can last with no end date (question 9).",
          "showIf": {
            "field": "$convicted",
            "equals": "yes"
          }
        },
        {
          "id": "q3",
          "type": "number",
          "label": "How old is the other person?",
          "hint": "Your best guess is fine. If the person is under 18, the case may go to juvenile court."
        }
      ]
    },
    {
      "id": "q4-6",
      "form": "PO-0101",
      "title": "Questions 4 to 6: other cases, the county, and your public address",
      "fields": [
        {
          "id": "q4.cases",
          "type": "group",
          "label": "Other court cases",
          "hint": "List every case that involves the other person, the child, or you: divorce, protection orders, paternity, guardianship, criminal, juvenile, civil, or military protection orders.",
          "fields": [
            {
              "id": "caseName",
              "type": "text",
              "label": "Case name",
              "hint": "Like Doe v. Doe"
            },
            {
              "id": "caseNumber",
              "type": "text",
              "label": "Case number"
            },
            {
              "id": "countyState",
              "type": "text",
              "label": "County and state"
            }
          ],
          "max": 5,
          "overflow": "4a",
          "itemLabel": "Case {n}",
          "addLabel": "Add a case"
        },
        {
          "id": "q4.school",
          "type": "text",
          "label": "If the child and the other person go to the same school, the school and school corporation"
        },
        {
          "id": "q5",
          "type": "multi",
          "label": "Why are you filing in this county?",
          "hint": "Check all that apply. At least one is needed.",
          "required": true,
          "options": [
            {
              "value": "a",
              "label": "The other person lives in this county"
            },
            {
              "value": "b",
              "label": "It happened in this county"
            },
            {
              "value": "c",
              "label": "The child lives in this county"
            },
            {
              "value": "d",
              "label": "I live in this county"
            }
          ]
        },
        {
          "id": "q6.attorney",
          "type": "yesno",
          "label": "Do you have a lawyer for this case?"
        },
        {
          "id": "q6",
          "type": "textarea",
          "label": "Your public mailing address",
          "hint": "This address is not kept secret, and the other person may see it. Use an address you are comfortable making public.",
          "showIf": {
            "field": "q6.attorney",
            "notEquals": "yes"
          },
          "required": true,
          "rows": 2
        }
      ]
    },
    {
      "id": "q9a",
      "form": "PO-0101",
      "title": "Question 9: orders the judge can make right away",
      "intro": "The judge can order these without a hearing. If your petition is based on harassment alone, the judge can order them only after a hearing within 30 days.",
      "fields": [
        {
          "id": "q9.protectMe",
          "type": "checkbox",
          "label": "Order the person not to commit or threaten violence, stalking, sex offenses, or sex grooming against the child"
        },
        {
          "id": "q9.protectFamily",
          "type": "checkbox",
          "label": "Order the person not to commit or threaten violence, stalking, or sex offenses against the child's family or household members"
        },
        {
          "id": "q9.protectFamily.names",
          "type": "textarea",
          "label": "Their names",
          "hint": "List them on the Confidential Form too, under other people to protect.",
          "showIf": {
            "field": "q9.protectFamily",
            "equals": true
          },
          "rows": 2
        },
        {
          "id": "q9.tracking",
          "type": "checkbox",
          "label": "Order the person not to use a tracking device to find me, the child's family or household members, or our property"
        },
        {
          "id": "q9.noContact",
          "type": "checkbox",
          "label": "Order the person not to harass, bother, call, contact, or communicate with the child, directly or through others"
        },
        {
          "id": "q9.stayAway",
          "type": "checkbox",
          "label": "Order the person to stay away from the child's home, school, work, or another place"
        },
        {
          "id": "q9.stayAway.place",
          "type": "text",
          "label": "Which place?",
          "hint": "Like residence, school, or place of employment",
          "showIf": {
            "field": "q9.stayAway",
            "equals": true
          }
        },
        {
          "id": "q9.stayAway.address",
          "type": "text",
          "label": "Its address",
          "showIf": {
            "field": "q9.stayAway",
            "equals": true
          }
        },
        {
          "id": "q9.indefinite",
          "type": "checkbox",
          "label": "Make the order last with no end date, because the person must register for life as a sex or violent offender",
          "showIf": {
            "field": "q2.offender.lifetime",
            "equals": "yes"
          }
        },
        {
          "id": "q9.familyPlaces",
          "type": "checkbox",
          "label": "Order the person to stay away from places the child's family or household members go often"
        },
        {
          "id": "q9.familyPlaces.places",
          "type": "textarea",
          "label": "Which places?",
          "hint": "Like a home, school, or workplace",
          "showIf": {
            "field": "q9.familyPlaces",
            "equals": true
          },
          "rows": 3
        },
        {
          "id": "q9.owners",
          "type": "textarea",
          "label": "Everyone who owns or signed the lease for the child's home",
          "hint": "The form asks everyone to fill this in.",
          "required": true,
          "rows": 2
        }
      ]
    },
